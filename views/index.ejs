<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CampusPulse - Premium Events</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Poppins', sans-serif; }
        
        body { 
            background: #020203; 
            min-height: 100vh; 
            color: #f3f4f6; 
            position: relative;
            overflow-x: hidden;
        }

        /* Home Page Load Effect: Center Gold Drop Expand */
        .page-transition-drop {
            position: fixed;
            top: 50%; left: 50%;
            width: 10px; height: 10px;
            background: #ffd700;
            border-radius: 50%;
            transform: translate(-50%, -50%);
            box-shadow: 0 0 30px #ffd700;
            z-index: 9999;
            pointer-events: none;
            animation: homeDropExpand 1.2s cubic-bezier(0.15, 0.85, 0.35, 1) forwards;
        }

        @keyframes homeDropExpand {
            0% { width: 10px; height: 10px; opacity: 1; }
            100% { width: 300vw; height: 300vw; opacity: 0; background: radial-gradient(circle, rgba(255,215,0,0.4) 0%, transparent 70%); }
        }

        /* Ongoing Dust Animation for Home */
        .gold-dust-home {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none;
            z-index: 0;
            background-image: 
                radial-gradient(circle, #ffd700 1.3px, transparent 1.3px),
                radial-gradient(circle, #ffaa00 1px, transparent 1px);
            background-size: 160px 160px, 220px 220px;
            animation: dustDriftHome 28s linear infinite;
        }

        @keyframes dustDriftHome {
            0% { background-position: 0 0, 50px 70px; opacity: 0.5; }
            50% { opacity: 0.9; }
            100% { background-position: 200px 300px, 270px 370px; opacity: 0.5; }
        }

        nav, .container { position: relative; z-index: 2; }
        nav { 
            background: rgba(12, 12, 12, 0.9); 
            padding: 20px 40px; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            border-bottom: 1px solid rgba(255, 215, 0, 0.3);
            box-shadow: 0 10px 30px rgba(0,0,0,0.8);
        }
        .logo { font-size: 24px; font-weight: 700; color: #ffd700; text-decoration: none; text-shadow: 0 0 12px rgba(255,215,0,0.5); }
        .nav-links a { margin-left: 20px; text-decoration: none; color: #d1d5db; font-weight: 500; transition: 0.3s; }
        .nav-links a:hover { color: #ffd700; }
        .admin-btn { background: linear-gradient(135deg, #ffd700 0%, #aa771c 100%); color: #000 !important; padding: 8px 18px; border-radius: 8px; font-weight: 700 !important; box-shadow: 0 0 15px rgba(255,215,0,0.4); }

        .container { max-width: 1200px; margin: 40px auto; padding: 0 20px; }
        .alert { background: rgba(6, 95, 70, 0.95); color: #a7f3d0; border: 1px solid #10b981; padding: 15px; border-radius: 8px; margin-bottom: 25px; text-align: center; font-weight: 500; }

        h2 { font-size: 28px; margin-bottom: 20px; color: #ffd700; font-weight: 600; text-shadow: 0 0 10px rgba(255,215,0,0.4); }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 25px; margin-bottom: 50px; }
        
        .card { 
            background: #111113; 
            border: 1.5px solid rgba(255, 215, 0, 0.3);
            border-radius: 16px; 
            padding: 30px; 
            box-shadow: 0 20px 40px rgba(0,0,0,0.9); 
            transition: 0.3s ease;
        }
        .card:hover { border-color: #ffd700; box-shadow: 0 0 25px rgba(255,215,0,0.3); transform: translateY(-4px); }
        .card h3 { font-size: 22px; color: #ffffff; margin-bottom: 10px; }
        .card p { color: #d1d5db; font-size: 14px; margin-bottom: 15px; line-height: 1.6; }
        .meta { font-size: 13px; color: #ffd700; font-weight: 600; margin-bottom: 15px; text-shadow: 0 0 5px rgba(255,215,0,0.3); }
        
        .price-tag { color: #38bdf8; font-weight: bold; font-size: 15px; margin-bottom: 20px; text-shadow: 0 0 10px rgba(56,189,248,0.3); }

        .btn-group { display: flex; gap: 10px; margin-bottom: 20px; }
        .btn { padding: 10px 18px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 14px; text-align: center; cursor: pointer; border: none; transition: 0.3s; }
        .btn-primary { background: linear-gradient(135deg, #ffd700 0%, #aa771c 100%); color: #000; flex: 1; box-shadow: 0 0 15px rgba(255,215,0,0.4); }
        .btn-primary:hover { opacity: 0.95; box-shadow: 0 0 25px rgba(255,215,0,0.7); }
        .btn-outline { background: transparent; color: #ffd700; border: 2px solid #ffd700; width: 100%; box-shadow: 0 0 10px rgba(255,215,0,0.2); }
        .btn-outline:hover { background: #ffd700; color: #000; box-shadow: 0 0 20px rgba(255,215,0,0.5); }

        .reg-form input { width: 100%; padding: 12px; background: #0a0a0c; border: 1px solid rgba(255, 215, 0, 0.3); color: white; border-radius: 8px; margin-bottom: 10px; font-size: 14px; }
        .reg-form input:focus { border-color: #ffd700; outline: none; box-shadow: 0 0 12px rgba(255,215,0,0.6); }
    </style>
</head>
<body>
    <div class="page-transition-drop"></div>
    <div class="gold-dust-home"></div>

    <nav>
        <a href="/" class="logo">✨ CampusPulse</a>
        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/my-registrations">🔍 My Registrations</a>
            <a href="/admin" class="admin-btn">⚙️ Admin Panel</a>
            <a href="/staff" style="color: #ffd700;">👨‍💼 Staff Portal</a>
        </div>
    </nav>

    <div class="container">
        <% if (typeof successMessage !== 'undefined' && successMessage) { %>
            <div class="alert"><%= successMessage %></div>
        <% } %>

        <div style="background: #111113; border: 1.5px solid #ffd700; padding: 20px 30px; border-radius: 16px; margin-bottom: 30px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 15px 35px rgba(0,0,0,0.7);">
            <div>
                <h3 style="color: #ffd700; margin-bottom: 5px;">💬 Student Community Discussions</h3>
                <p style="color: #d1d5db; font-size: 13px; margin: 0;">Join active Q&A threads and share insights with peers.</p>
            </div>
            <a href="/discussions" class="btn" style="background: linear-gradient(135deg, #ffd700 0%, #aa771c 100%); color: #000; text-decoration: none; padding: 12px 24px; border-radius: 8px; font-weight: 700; box-shadow: 0 0 15px rgba(255,215,0,0.4);">View Discussions 🚀</a>
        </div>

        <div class="card" style="background: linear-gradient(135deg, #111113 0%, #1a1a1e 100%); border: 1.5px solid #ffd700; margin-bottom: 40px; box-shadow: 0 20px 40px rgba(0,0,0,0.9);">
            <h2 style="color: #ffd700;">🎓 Student Registration Portal</h2>
            <p style="color: #d1d5db; margin-bottom: 20px;">Register your details here before signing up for campus events.</p>
            <form action="/signup" method="POST" style="display: grid; gap: 12px; max-width: 500px;" class="reg-form">
                <input type="text" name="fullName" placeholder="Full Name" required>
                <input type="text" name="username" placeholder="Student ID / Username" required>
                <input type="text" name="contactNumber" placeholder="Contact Number" required>
                <input type="email" name="email" placeholder="Email Address" required>
                <button type="submit" class="btn" style="background: linear-gradient(135deg, #ffd700 0%, #aa771c 100%); color: #000; font-weight: 700; padding: 12px; border-radius: 8px; box-shadow: 0 0 15px rgba(255,215,0,0.4);">Register Student 🚀</button>
            </form>
        </div>

        <h2>✨ Upcoming Events</h2>
        <div class="grid">
            <% if (oracleEvents && oracleEvents.length > 0) { %>
                <% oracleEvents.forEach(event => { %>
                    <div class="card">
                        <h3><%= event.TITLE || event.title %></h3>
                        <p><%= event.DESCRIPTION || event.description %></p>
                        <div class="meta">📅 Date: <%= event.EVENT_DATE ? new Date(event.EVENT_DATE || event.event_date).toISOString().split('T')[0] : '' %> | 📍 Venue: <%= event.VENUE || event.venue %></div>
                        <div class="price-tag">💰 Ticket Fee: LKR <%= event.PRICE || event.price || 0 %> /=</div>
                        <div class="btn-group">
                            <a href="/event/<%= event.EVENT_ID || event.event_id %>" class="btn btn-outline">View Details & Feedback</a>
                        </div>
                        <form action="/register" method="POST" class="reg-form">
                            <input type="hidden" name="eventId" value="<%= event.EVENT_ID || event.event_id %>">
                            <input type="text" name="username" placeholder="Enter Student ID" required>
                            <button type="submit" class="btn btn-primary">Register Now 🚀</button>
                        </form>
                    </div>
                <% }) %>
            <% } else { %>
                <p>No upcoming events available.</p>
            <% } %>
        </div>

        <h2>💬 Recent Feedbacks & Reviews</h2>
        <div class="card">
            <% if (!mongoLogs || mongoLogs.length === 0) { %>
                <p style="color: #d1d5db;">No feedbacks available.</p>
            <% } else { %>
                <div style="display: grid; gap: 15px;">
                    <div style="background: #0a0a0c; padding: 15px; border-radius: 8px; border-left: 4px solid #ffd700; box-shadow: 0 0 10px rgba(255,215,0,0.1);">
                        <h5 style="color: #ffffff; margin-bottom: 5px;">Student ID: <%= mongoLogs[0].student_id %></h5>
                        <p style="color: #d1d5db; font-size: 14px; margin: 0;"><%= mongoLogs[0].comment %></p>
                        <small style="color: #ffd700;">Rating: ⭐<%= mongoLogs[0].rating %>/5</small>
                    </div>
                    <% if (mongoLogs.length > 1) { %>
                        <div id="moreFeedbacks" style="display: none; display: grid; gap: 15px; margin-top: 15px;">
                            <% for(let i = 1; i < mongoLogs.length; i++) { %>
                                <div style="background: #0a0a0c; padding: 15px; border-radius: 8px; border-left: 4px solid #ffd700; box-shadow: 0 0 10px rgba(255,215,0,0.1);">
                                    <h5 style="color: #ffffff; margin-bottom: 5px;">Student ID: <%= mongoLogs[i].student_id %></h5>
                                    <p style="color: #d1d5db; font-size: 14px; margin: 0;"><%= mongoLogs[i].comment %></p>
                                    <small style="color: #ffd700;">Rating: ⭐<%= mongoLogs[i].rating %>/5</small>
                                </div>
                            <% } %>
                        </div>
                        <button onclick="toggleSeeMore()" id="seeMoreBtn" class="btn btn-outline" style="margin-top: 15px;">See More 🔽</button>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>
    <script>
        function toggleSeeMore() {
            const moreDiv = document.getElementById('moreFeedbacks');
            const btn = document.getElementById('seeMoreBtn');
            if (moreDiv.style.display === 'none' || moreDiv.style.display === '') {
                moreDiv.style.display = 'grid';
                btn.innerHTML = 'See Less 🔼';
            } else {
                moreDiv.style.display = 'none';
                btn.innerHTML = 'See More 🔽';
            }
        }
    </script>
</body>
</html>