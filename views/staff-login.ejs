<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Staff Login - CampusPulse</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Poppins', sans-serif; }
        body { 
            background: #020203; 
            color: #f3f4f6; 
            min-height: 100vh; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            overflow: hidden; 
        }
        
        .card { 
            background: #111113; 
            border: 1.5px solid rgba(255, 215, 0, 0.4); 
            padding: 35px 30px; 
            border-radius: 18px; 
            width: 100%; max-width: 380px; 
            text-align: center; 
            box-shadow: 0 20px 40px rgba(0,0,0,0.9); 
            animation: slideUp 0.6s ease-out forwards;
        }

        @keyframes slideUp {
            0% { opacity: 0; transform: translateY(30px) scale(0.95); }
            100% { opacity: 1; transform: translateY(0) scale(1); }
        }

        h2 { color: #ffd700; margin-bottom: 20px; font-size: 22px; text-shadow: 0 0 8px rgba(255,215,0,0.3); }
        
        .error { 
            background: rgba(239, 68, 68, 0.2); 
            color: #fca5a5; 
            border: 1px solid #ef4444; 
            padding: 10px; 
            border-radius: 8px; 
            margin-bottom: 15px; 
            font-size: 13px; 
            animation: shake 0.4s ease-in-out;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-5px); }
            40%, 80% { transform: translateX(5px); }
        }

        form { display: flex; flex-direction: column; gap: 12px; }

        input { 
            width: 100%; padding: 12px; background: #0a0a0c; 
            border: 1px solid rgba(255, 215, 0, 0.3); color: white; 
            border-radius: 8px; text-align: center; font-size: 14px; 
        }
        input:focus { border-color: #ffd700; outline: none; box-shadow: 0 0 10px rgba(255,215,0,0.5); }
        
        .btn { 
            width: 100%; padding: 12px; background: linear-gradient(135deg, #ffd700 0%, #aa771c 100%); 
            color: #000; border: none; border-radius: 8px; font-weight: 700; cursor: pointer; font-size: 14px; 
            box-shadow: 0 0 12px rgba(255,215,0,0.3); transition: 0.3s; margin-top: 5px;
        }
        .btn:hover { opacity: 0.9; box-shadow: 0 0 20px rgba(255,215,0,0.6); }
        
        .back-link { 
            display: block; 
            margin-top: 18px; 
            color: #9ca3af; 
            text-decoration: none; 
            font-size: 13px; 
            transition: 0.3s; 
        }
        .back-link:hover { color: #ffd700; }
    </style>
</head>
<body>
    <div class="card">
        <h2>👨‍🏫 Staff Portal</h2>
        
        <!-- Display error message only when password is incorrect -->
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="error"><%= error %></div>
        <% } %>
        
        <form action="/staff" method="GET">
            <input type="password" name="pass" placeholder="Enter Staff Password" required autofocus>
            <button type="submit" class="btn">Login 🚀</button>
        </form>
        
        <a href="/" class="back-link">⬅️ Back to Home</a>
    </div>
</body>
</html>