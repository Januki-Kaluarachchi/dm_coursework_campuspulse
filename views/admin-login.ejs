<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login - CampusPulse</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Poppins', sans-serif; }
        
        body { 
            background: #020203; 
            color: #f3f4f6; 
            min-height: 100vh; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            position: relative; 
            overflow: hidden;
        }

        /* Pitch Black Water Surface */
        .water-surface {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: #020203;
            z-index: 0;
            overflow: hidden;
        }

        /* Slow Gold Drop that ripples and settles into dark gold theme */
        .gold-drop-ripple {
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            width: 8px; height: 8px;
            background: #ffd700;
            border-radius: 50%;
            box-shadow: 0 0 20px #ffd700, 0 0 40px #aa771c;
            animation: slowRipple 1.6s cubic-bezier(0.15, 0.85, 0.35, 1) forwards;
        }

        @keyframes slowRipple {
            0% { width: 8px; height: 8px; opacity: 1; box-shadow: 0 0 15px #ffd700; }
            50% { opacity: 0.9; }
            100% { width: 250vw; height: 250vw; opacity: 1; background: radial-gradient(circle, rgba(212,175,55,0.22) 0%, rgba(170,119,28,0.12) 35%, rgba(5,5,7,0.98) 70%, #020203 100%); box-shadow: none; }
        }

        /* Admin Login Card */
        .card { 
            background: rgba(14, 14, 16, 0.94); 
            border: 1.5px solid rgba(212, 175, 55, 0.4); 
            padding: 40px; 
            border-radius: 18px; 
            width: 100%; max-width: 400px; 
            box-shadow: 0 25px 50px rgba(0,0,0,0.9), 0 0 20px rgba(212,175,55,0.15); 
            position: relative; z-index: 2; 
            text-align: center; 
            opacity: 0; transform: scale(0.96);
            animation: cardReveal 0.8s ease-out 1s forwards;
            backdrop-filter: blur(10px);
        }

        @keyframes cardReveal {
            to { opacity: 1; transform: scale(1); }
        }

        h2 { color: #d4af37; margin-bottom: 20px; font-size: 24px; text-shadow: 0 0 10px rgba(212,175,55,0.3); }

        input { 
            width: 100%; padding: 13px; background: #08080a; 
            border: 1px solid rgba(212, 175, 55, 0.35); color: white; 
            border-radius: 8px; margin-bottom: 15px; font-size: 14px; text-align: center; 
        }

        input:focus { border-color: #d4af37; outline: none; box-shadow: 0 0 12px rgba(212,175,55,0.5); }

        .btn { 
            width: 100%; padding: 12px; background: linear-gradient(135deg, #d4af37 0%, #aa771c 100%); 
            color: #000; border: none; border-radius: 8px; font-weight: 700; cursor: pointer; font-size: 14px; 
            box-shadow: 0 0 15px rgba(212,175,55,0.3); transition: 0.3s;
        }
        .btn:hover { opacity: 0.95; box-shadow: 0 0 25px rgba(212,175,55,0.6); }

        .back-link { display: inline-block; margin-top: 20px; color: #9ca3af; text-decoration: none; font-size: 13px; transition: 0.3s; }
        .back-link:hover { color: #d4af37; }

        .error { background: rgba(239, 68, 68, 0.2); color: #fca5a5; border: 1px solid #ef4444; padding: 10px; border-radius: 6px; margin-bottom: 15px; font-size: 13px; }
    </style>
</head>
<body>
    <div class="water-surface">
        <div class="gold-drop-ripple"></div>
    </div>

    <div class="card">
        <h2>🔐 Admin Portal</h2>
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="error"><%= error %></div>
        <% } %>
        <form action="/admin" method="GET">
            <input type="password" name="pass" placeholder="Enter Admin Password" required autofocus>
            <button type="submit" class="btn">Login 🚀</button>
        </form>
        <a href="/" class="back-link">⬅️ Back to Home</a>
    </div>
</body>
</html>